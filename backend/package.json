{
  "name": "campus-seminar-hall-backend",
  "version": "1.0.0",
  "description": "Campus Seminar Hall Booking & Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "db:init": "mysql -u root -p campus_seminar_hall < schema.sql && mysql -u root -p campus_seminar_hall < seed.sql",
    "db:seed": "mysql -u root -p campus_seminar_hall < seed.sql"
  },
  "keywords": [
    "seminar-hall",
    "booking",
    "campus",
    "management"
  ],
  "author": "Campus Dev Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "mysql2": "^3.11.3",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.3"
  }
}
